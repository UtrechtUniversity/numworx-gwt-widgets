<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
  	<groupId>fi.parentgwt</groupId>
  	<artifactId>ParentGWT</artifactId>
  	<version>0.0.9-SNAPSHOT</version>
  	<relativePath>../ParentGWT</relativePath>
  </parent>
  <groupId>nl.uu.fi.dwo.mobile</groupId>
  <artifactId>WiskOpdrPlayer</artifactId>
  <version>2.5.47-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>WiskOpdr Player</name>
  <properties>
	<finalName>WiskOpdrPlayer</finalName>
	<gwtModule>${project.groupId}.WiskOpdrPlayer</gwtModule>
	<gwt.style>OBFUSCATED</gwt.style>
	<runTarget>${project.artifactId}.html</runTarget>
	<gwtVersion>2.10.0</gwtVersion>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>dwo</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
		<dependency>
			<groupId>org.gwtproject</groupId>
			<artifactId>gwt-user</artifactId>
			<scope>provided</scope>
		</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>dwoplayer</artifactId>
  		<classifier>classes</classifier>
  		<exclusions>
  			<exclusion>
  				<groupId>fi.wiskopdrgwt</groupId>
  				<artifactId>wiskopdrgwt</artifactId>
  			</exclusion>
  		</exclusions>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>dwoplayer</artifactId>
  		<type>war</type>
  		<scope>runtime</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>dwoplayer</artifactId>
  		<classifier>sources</classifier>
  		<exclusions>
  			<exclusion>
  				<groupId>fi.wiskopdrgwt</groupId>
  				<artifactId>wiskopdrgwt</artifactId>
  			</exclusion>
  		</exclusions>
  		<scope>provided</scope>
  	</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<scope>provided</scope>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.0</version>
			<classifier>sources</classifier>
			<scope>provided</scope>
		</dependency>
                <dependency>
                        <groupId>com.googlecode.mgwt</groupId>
                        <artifactId>mgwt</artifactId>
                        <scope>provided</scope>
                </dependency>
  </dependencies>
  <build>
	<finalName>${finalName}</finalName>
  	<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${gwtVersion}</version>
				<configuration>
					<localWorkers>1</localWorkers>
					<module>${gwtModule}</module>
					<runTarget>${runTarget}</runTarget>
					<extraJvmArgs>-Xms768m -Xmx2048m</extraJvmArgs>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
	       			<warSourceDirectory>src/main/webapp</warSourceDirectory>
	        		<packagingIncludes>**</packagingIncludes>
				   <overlays>
					<overlay>
						<groupId>nl.uu.fi.dwo.mobile</groupId>
						<artifactId>dwoplayer</artifactId>
						<includes>
							<include>DWOplayer.css</include>
							<include>KeyboardGWT.css</include>
							<include>PrintPlayer.css</include>
							<include>images/**</include>
							<include>scripts/**</include>
						</includes>
					</overlay>
				  </overlays>
				  <warSourceExcludes>WEB-INF/**,META-INF/**</warSourceExcludes>
				</configuration>
			</plugin>
  	</plugins>
  </build>
</project>
