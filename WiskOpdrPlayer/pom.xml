<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
  	<groupId>fi.parentgwt</groupId>
  	<artifactId>ParentGWT</artifactId>
  	<version>0.0.8-SNAPSHOT</version>
  	<relativePath>../ParentGWT</relativePath>
  </parent>
  <groupId>nl.uu.fi.dwo.mobile</groupId>
  <artifactId>WiskOpdrPlayer</artifactId>
  <version>2.5.23-SNAPSHOT</version>
  <packaging>war</packaging>
  <name>WiskOpdr Player</name>
  <properties>
	<finalName>WiskOpdrPlayer</finalName>
	<gwtModule>${project.groupId}.WiskOpdrPlayer</gwtModule>
	<gwt.style>OBFUSCATED</gwt.style>
	<runTarget>${project.artifactId}.html</runTarget>
  </properties>
  <dependencies>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-user</artifactId>
			<scope>provided</scope>
		</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>DWOplayer</artifactId>
  		<version>2.5.22</version>
  		<classifier>classes</classifier>
  		<exclusions>
  			<exclusion>
  				<groupId>fi.wiskopdrgwt</groupId>
  				<artifactId>WiskOpdrGWT</artifactId>
  			</exclusion>
  		</exclusions>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>DWOplayer</artifactId>
  		<version>2.5.22</version>
  		<classifier>dwo2</classifier>
  		<type>war</type>
  		<scope>runtime</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>DWOplayer</artifactId>
  		<version>2.5.22</version>
  		<classifier>sources</classifier>
  		<exclusions>
  			<exclusion>
  				<groupId>fi.wiskopdrgwt</groupId>
  				<artifactId>WiskOpdrGWT</artifactId>
  			</exclusion>
  		</exclusions>
  		<scope>provided</scope>
  	</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<version>0.1.16</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<version>0.1.16</version>
			<scope>provided</scope>
			<classifier>sources</classifier>
		</dependency>
  </dependencies>
  <build>
	<finalName>${finalName}</finalName>
  	<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${gwtVersion}</version>
				<configuration>
					<module>${gwtModule}</module>
					<runTarget>${runTarget}</runTarget>
					<extraJvmArgs>-Xms768m -Xmx2048m</extraJvmArgs>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.2.3</version>
				<configuration>
				   <overlays>
					<overlay>
						<groupId>nl.uu.fi.dwo.mobile</groupId>
						<artifactId>DWOplayer</artifactId>
						<classifier>dwo2</classifier>
						<includes>
							<include>DWOplayer.css</include>
							<include>KeyboardGWT.css</include>
							<include>images/**</include>
							<include>scripts/**</include>
						</includes>
					</overlay>
				  </overlays>
				  <warSourceExcludes>WEB-INF/**,META-INF/**</warSourceExcludes>
				</configuration>
			</plugin>
  	</plugins>
  </build>
</project>
