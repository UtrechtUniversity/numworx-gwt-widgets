<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
  	<groupId>fi.parentgwt</groupId>
  	<artifactId>parentgwt</artifactId>
  	<version>3.0.0-SNAPSHOT</version>
  	<relativePath>../ParentGWT</relativePath>
  </parent>
  <groupId>nl.uu.fi.dwo.mobile</groupId>
  <artifactId>printplayer</artifactId>
  <packaging>war</packaging>
  <name>PrintPlayer</name>
  <properties>
	<finalName>PrintPlayer</finalName>
	<gwtModule>${project.groupId}.PrintPlayer</gwtModule>
	<gwt.style>OBFUSCATED</gwt.style>
	<runTarget>${project.name}.html</runTarget>
	<gwtVersion>2.10.0</gwtVersion>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>dwo</artifactId>
        <version>${dwoVersion}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-user</artifactId>
			<scope>provided</scope>
		</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>dwoplayer</artifactId>
  		<classifier>classes</classifier>
		<scope>provided</scope>
  		<exclusions>
  			<exclusion>
  				<groupId>fi.wiskopdrgwt</groupId>
  				<artifactId>wiskopdrgwt</artifactId>
  			</exclusion>
  		</exclusions>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>dwoplayer</artifactId>
  		<classifier>sources</classifier>
 		<scope>provided</scope>
 		<exclusions>
  			<exclusion>
  				<groupId>fi.wiskopdrgwt</groupId>
  				<artifactId>wiskopdrgwt</artifactId>
  			</exclusion>
  		</exclusions>
  	</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<classifier>sources</classifier>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.0</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.0</version>
			<classifier>sources</classifier>
			<scope>provided</scope>
		</dependency>
  </dependencies>
  <build>
	<finalName>${finalName}</finalName>
  	<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${gwtVersion}</version>
				<configuration>
					<localWorkers>1</localWorkers>
					<module>${gwtModule}</module>
					<runTarget>${runTarget}</runTarget>
					<extraJvmArgs>-Xms768m -Xmx2048m</extraJvmArgs>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
        <plugin>
          <artifactId>maven-war-plugin</artifactId>
          <version>3.2.3</version>
          <configuration>
            <warSourceDirectory>src/main/webapp</warSourceDirectory>
            <packagingIncludes>PrintPlayer/**</packagingIncludes>
          </configuration>
        </plugin>
  	</plugins>
  </build>
</project>
