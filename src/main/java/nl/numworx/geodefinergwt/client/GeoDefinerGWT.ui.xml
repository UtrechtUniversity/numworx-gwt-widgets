<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:geo="urn:import:nl.numworx.geodefinergwt.client"
	>
	<ui:with type="nl.numworx.geodefinergwt.client.i18n.messages" field="rb"></ui:with>
	<g:DockLayoutPanel unit='PX'>
		<g:north size="38">
			<geo:ToolBoxPanel ui:field="toolbox" addStyleNames="toolbox" />
		</g:north>
		<g:center>
			<geo:InstanceViewer ui:field='widget'/>
		</g:center>
		<g:south size="30">
			<g:DockLayoutPanel unit='PX'>
			<g:center>
				<g:Label ui:field="southPanel "/>
			</g:center>
			<g:east size="80">
				<g:FlowPanel ui:field="check" addStyleNames="check">
				  <g:Button ui:field="checkBtn" ><ui:text from="{rb.kijkNa}"/></g:Button>
				</g:FlowPanel>
			</g:east>
			</g:DockLayoutPanel>
		</g:south>
	</g:DockLayoutPanel>
</ui:UiBinder> 