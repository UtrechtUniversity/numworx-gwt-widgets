<?xml version="1.0" encoding="UTF-8"?>
<!--
  When updating your version of GWT, you should also update this DTD reference,
  so that your app can take advantage of the latest GWT module capabilities.
-->
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.5.1//EN"
  "http://google-web-toolkit.googlecode.com/svn/tags/2.5.1/distro-source/core/src/gwt-module.dtd">
<module rename-to='graphtoolgwt'>
  <!-- Inherit the core Web Toolkit stuff.                        -->
  <inherits name='com.google.gwt.user.User'/>
  <define-property name="gwt.logging.popupHandler"
		values="ENABLED, DISABLED" />
  <set-property name="gwt.logging.popupHandler" value="DISABLED" />
 <!-- <set-property name = "gwt.logging.enabled" value = "TRUE"/> -->
 
  <!-- Inherit the default GWT style sheet.  You can change       -->
  <!-- the theme of your GWT application by uncommenting          -->
  <!-- any one of the following lines.                            -->
  <inherits name='com.google.gwt.user.theme.clean.Clean'/>
  <!-- <inherits name='com.google.gwt.user.theme.standard.Standard'/> -->
  <!-- <inherits name='com.google.gwt.user.theme.chrome.Chrome'/> -->
  <!-- <inherits name='com.google.gwt.user.theme.dark.Dark'/>     -->

  <!-- Other module inherits                                      -->
  <inherits name="com.googlecode.mgwt.MGWT"/>
  <inherits name='nl.uu.fi.dwo.interaction.Interaction' />
  <inherits name='nl.uu.fi.dwo.ideas.Ideas' />
  <inherits name="fi.wiskopdr.WiskOpdr"/>
  <inherits name="nl.uu.fi.dwo.formule.Formule" />
  <inherits name='gwt.Geom' />
  <inherits name="fi.beans.lineairealgebra.LineaireAlgebra" />
  <inherits name="fi.statistiekgwt.StatistiekGWT-DWO" />
  <inherits name='com.googlecode.gwt.charts.Charts' />
  <inherits name='com.vaadin.pointerevents.PointerEvents' />
  
  

  <!-- Specify the app entry point class.                         -->
  <entry-point class='fi.graphtoolgwt.client.GraphToolGWTDebug'/>

  <!-- Specify the paths for translatable code                    -->
  <source path='client'/>
  
  <add-linker name='xsiframe' />

<!-- Logging TRUE/FALSE FINEST/.../SEVERE -->   
<!--     <set-property name="gwt.logging.logLevel" value="INFO"/> -->
<!--     <set-property name="gwt.logging.enabled" value="TRUE"/> -->


</module>
