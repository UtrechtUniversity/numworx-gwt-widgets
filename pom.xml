<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.kladjegwt</groupId>
  <artifactId>KladjeGWT</artifactId>
  <packaging>war</packaging>
  <build>
  	<finalName>${project.artifactId}</finalName>
	<sourceDirectory>src</sourceDirectory>
  	<testSourceDirectory>test</testSourceDirectory>
    <resources>
    	<resource>
    	   <directory>src</directory>
    	   <excludes><exclude>**/*.java</exclude></excludes>
    	</resource>
    </resources>
  	<plugins>
      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
        	<warSourceDirectory>war</warSourceDirectory>        
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>gwt-maven-plugin</artifactId>
        <version>${gwtVersion}</version>
         <configuration>
              <module>${project.groupId}.${project.artifactId}</module>
              <runTarget>${project.artifactId}.html</runTarget>
        	  <warSourceDirectory>war</warSourceDirectory>
        	  <style>PRETTY</style>        
             </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
             </goals>
          </execution>
          </executions>
      </plugin>
      <plugin>
<!-- usage: jetty:run-war of jetty:run-exploded -->
  		<groupId>org.eclipse.jetty</groupId>
 		<artifactId>jetty-maven-plugin</artifactId>
  			<version>9.0.0.v20130308</version>
  	  </plugin>
    </plugins>
  </build>
  <dependencies>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-user</artifactId>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>interaction</artifactId>
  		<version>0.1.1</version>
  	</dependency>
  	<dependency>
		<groupId>nl.uu.fi.dwo.mobile</groupId>
		<artifactId>formule</artifactId>
		<version>0.1.1</version>
	</dependency>
			<dependency>
			<groupId>nl.uu.fi.dwo.ideas</groupId>
			<artifactId>IdeasGWT</artifactId>
			<version>0.0.2</version>
		</dependency>
		<dependency>
			<groupId>fi.wiskopdrgwt</groupId>
			<artifactId>WiskOpdrGWT</artifactId>
			<version>0.0.5</version>
	  		<exclusions>
	  			<exclusion>
	  				<artifactId>IdeasGWT</artifactId>
	  				<groupId>nl.uu.fi.dwo.ideas</groupId>
	  			</exclusion>
	  		</exclusions>
		</dependency>
<!--   	<dependency> -->
<!--   		<groupId>com.googlecode.mgwt</groupId> -->
<!--   		<artifactId>MGWT</artifactId> -->
<!--   	</dependency> -->
  	<dependency>
  		<groupId>fi.writemathgwt</groupId>
  		<artifactId>WriteMathGWT</artifactId>
  		<version>2.3.2-SNAPSHOT</version>
  	</dependency>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-dev</artifactId>
  		<scope>test</scope>
  		<version>${gwtVersion}</version>
  	</dependency>
  </dependencies>
  <parent>
  	<groupId>fi.parentgwt</groupId>
  	<artifactId>ParentGWT</artifactId>
  	<version>0.0.6</version>
  	<relativePath>../ParentGWT</relativePath>
  </parent>
  <name>Kladje</name>
  <version>0.0.7-SNAPSHOT</version>
  <properties>
  	<gwt.compiler.force>true</gwt.compiler.force>
  </properties>
</project>
