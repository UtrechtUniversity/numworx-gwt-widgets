<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app
    PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>

  <!-- Default page to serve -->
  <welcome-file-list>
    <welcome-file>ReplGWT.html</welcome-file>
  </welcome-file-list>
  <servlet>
  	<servlet-name>get_input</servlet-name>
  	<servlet-class>fi.dwo.server.apps.GetInput</servlet-class>
  </servlet>
  <servlet-mapping>
  	<servlet-name>get_input</servlet-name>
  	<url-pattern>/dwo/apps/get_input/*</url-pattern>
  </servlet-mapping>

</web-app>
